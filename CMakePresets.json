{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-x86",
      "displayName": "Linux x86 (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x86",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mingw-x86",
      "displayName": "MinGW x86 (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-x86",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-x86.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-x86",
      "displayName": "MSVC x86",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/msvc-x86"
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x86",
      "configurePreset": "linux-x86"
    },
    {
      "name": "mingw-x86",
      "configurePreset": "mingw-x86"
    },
    {
      "name": "msvc-x86",
      "configurePreset": "msvc-x86",
      "configuration": "Release"
    }
  ]
}

